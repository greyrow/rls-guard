{
  "name": "rls-guard",
  "version": "0.1.0",
  "description": "Design-time and audit agent for Postgres/Supabase row-level security, CRUD permissions, and cascade-delete rules.",
  "type": "module",
  "bin": {
    "rls-guard": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/tools/*.test.ts"
  },
  "license": "MIT",
  "keywords": [
    "postgres",
    "supabase",
    "row-level-security",
    "rls",
    "authorization",
    "rbac",
    "cli",
    "claude-agent-sdk"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
